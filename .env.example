# URL final do site. Na Hostinger, use https://seudominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Use apenas números, com código do país e DDD.
NEXT_PUBLIC_WHATSAPP_NUMBER=5571999999999

# Conexão MySQL/MariaDB. Necessária apenas quando o banco for utilizado.
# Não exponha esta variável com o prefixo NEXT_PUBLIC_.
DATABASE_URL=mysql://usuario:senha@servidor:3306/banco

# Envio opcional do resumo por e-mail via Resend.
# Variáveis privadas: nunca use NEXT_PUBLIC_ e nunca envie valores reais ao Git.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Sem domínio, use apenas em testes e envie para o e-mail da própria conta Resend:
# RESULT_FROM_EMAIL=Instituto Dr. Marcel <onboarding@resend.dev>
# Em produção, substitua pelo remetente de um domínio verificado:
RESULT_FROM_EMAIL=Instituto Dr. Marcel <resultados@seudominio.com.br>
RESULT_REPLY_TO=contato@seudominio.com.br

