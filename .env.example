# URL final do site. Na Hostinger, use https://seudominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Use apenas números, com código do país e DDD.
NEXT_PUBLIC_WHATSAPP_NUMBER=5571999999999

# Conexão MySQL/MariaDB. Necessária apenas quando o banco for utilizado.
# Não exponha esta variável com o prefixo NEXT_PUBLIC_.
DATABASE_URL=mysql://usuario:senha@servidor:3306/banco

